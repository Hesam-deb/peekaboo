# SELinux module for Fedora and friends. Login and lock screens run pam_peekaboo in
# xdm_t; all it needs is the socket of peekabood. (The camera is opened by the
# service, never by the login screen.)
#
#   checkmodule -M -m -o peekaboo.mod peekaboo.te
#   semodule_package -o peekaboo.pp -m peekaboo.mod
#   sudo semodule -i peekaboo.pp
#
# Compiles, but has not been tried on a running system yet.
module peekaboo 1.0;

require {
	type xdm_t;
	type init_t;
	type unconfined_service_t;
	type var_run_t;
	class unix_stream_socket connectto;
	class sock_file write;
}

allow xdm_t { init_t unconfined_service_t }:unix_stream_socket connectto;
allow xdm_t var_run_t:sock_file write;
